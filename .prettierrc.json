{
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",

  "pluginSearchDirs": false,
  "plugins": ["prettier-plugin-tailwindcss"],

  "tailwindConfig": "./tailwind.config.js",
  "tailwindFunctions": ["clsx", "cn", "twMerge", "cva"],

  "overrides": [
    {
      "files": ["*.md", "*.mdx"],
      "options": { "proseWrap": "always", "printWidth": 80 }
    },
    {
      "files": ["*.yml", "*.yaml", "*.json", "*.jsonc"],
      "options": { "singleQuote": false }
    }
  ]
}
